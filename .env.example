# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it, and never paste real
# credentials into a chat, an issue, or a recorded codegen script.

AA_BASE_URL=https://community.cloud.automationanywhere.digital
AA_USERNAME=your_username_here
AA_PASSWORD=your_password_here

# Optional: skip the "create a new form" flow and drive an existing form.
# Leave blank to have Use Case 1 create its own form from scratch.
AA_FORM_URL=
